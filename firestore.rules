/**
 * Luật truy cập Firestore cho Quỹ CLB Cầu Lông Arito.
 *
 * Nguyên tắc: ai cũng đọc được số liệu (trang công khai như hiện nay), nhưng chỉ
 * tài khoản có sẵn một hồ sơ trong "admins" mới được ghi. Muốn cấp quyền cho ai
 * thì tạo tài khoản cho họ rồi thêm một tài liệu admins/<uid>; thu hồi thì xoá
 * tài liệu đó — không cần sửa code hay đổi mật khẩu của ai khác.
 *
 * Danh sách admins chỉ sửa được trong Firebase Console, trang web không ghi được.
 */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Số tiền phải là số nguyên không âm và trong ngưỡng hợp lý.
    function isCleanAmount(value) {
      return value is int && value >= 0 && value <= 1000000000;
    }

    // Quy định đóng quỹ, mã QR, danh sách hoạt động, thông tin chung.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mỗi tháng một tài liệu, khoá dạng "2026-08".
    match /months/{monthId} {
      allow read: if true;
      allow write: if isAdmin() && monthId.matches('^[0-9]{4}-[0-9]{2}$');
    }

    // Mỗi khoản thu hoặc chi một tài liệu.
    match /transactions/{txId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.type in ['thu', 'chi']
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isCleanAmount(request.resource.data.amount)
        && request.resource.data.desc is string
        && request.resource.data.desc.size() <= 300
        && request.resource.data.cat is string
        && request.resource.data.cat.size() <= 120;
    }

    // Ai là quản trị viên: chỉ người đã đăng nhập mới đọc được, không ai ghi được
    // từ trang web. Thêm hoặc bớt admin làm trực tiếp trong Firebase Console.
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Mọi đường dẫn khác đều bị từ chối.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
